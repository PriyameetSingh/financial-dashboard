# Copy to `.env` (git-ignored) and fill secrets. Docker Compose reads this file
# and overrides DATABASE_URL / DIRECT_URL / AUTH_URL / NODE_ENV / DEV_AUTH so
# the app container talks to the `postgres` service.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Laptop-without-Compose convention (user postgres, database hudd):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/hudd"
# Docker Compose (this repo's default — keep hudd_nexus):
DATABASE_URL="postgresql://hudd_user:hudd_password@127.0.0.1:5433/hudd_nexus"
DIRECT_URL="postgresql://hudd_user:hudd_password@127.0.0.1:5433/hudd_nexus"

# -----------------------------------------------------------------------------
# Next.js base path
# -----------------------------------------------------------------------------
# Empty = app at the domain root (dev/demo). Must be set at `next dev` / `next
# build` start; Next inlines it. Set to /hudd-dashboard to restore the historical
# Odisha nginx location (product.airawat.org/hudd-dashboard).
NEXT_PUBLIC_BASE_PATH=""

# -----------------------------------------------------------------------------
# Phase 2 multi-tenancy
# -----------------------------------------------------------------------------
# Tenants are resolved from the request Host: `<slug>.<domain>` matches
# tenants.slug. While exactly one tenant is active, an unresolved request falls
# back to it; once a second tenant is active, unresolved requests are denied.
#
# DEVELOPMENT ONLY: land on a specific tenant when the host carries no slug
# (e.g. http://localhost:3000). Ignored outside NODE_ENV=development.
# Leave empty for the two-tenant demo (Odisha + Suryapur) — use the hostnames
# in RUNBOOK.md instead. Set to "demo" after running
# `node prisma/seed_demo_tenant.js` only if you want localhost to land on
# Suryapur.
DEV_DEFAULT_TENANT_SLUG=""

# -----------------------------------------------------------------------------
# Auth.js v5 (NextAuth) — required to boot
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Root deploy (dev/demo). With NEXT_PUBLIC_BASE_PATH=/hudd-dashboard this is
# http://localhost:8765/hudd-dashboard/api/auth
AUTH_URL="http://localhost:3000/api/auth"
AUTH_TRUST_HOST="true"

# Dev-only session mint at /api/dev/session. Dead in a production `next build`.
DEV_AUTH_ENABLED="1"

# -----------------------------------------------------------------------------
# Keycloak — required at import even when using dev-auth (auth.ts throws if unset)
# -----------------------------------------------------------------------------
KEYCLOAK_ISSUER="http://13.206.129.143:8080/realms/airawat-dashboard"
KEYCLOAK_CLIENT_ID="airawat-web"
# From the Keycloak client's Credentials tab (confidential client).
KEYCLOAK_CLIENT_SECRET="replace-with-keycloak-client-secret"
# Optional override for admin role-mapping target client. Falls back to KEYCLOAK_CLIENT_ID.
KEYCLOAK_ROLE_CLIENT_ID="airawat-web"
KEYCLOAK_ADMIN_CLIENT_ID="replace-with-keycloak-admin-client-id"
KEYCLOAK_ADMIN_CLIENT_SECRET="replace-with-keycloak-admin-client-secret"
KEYCLOAK_REALM="airawat-dashboard"
# Register this exact URI in Keycloak "Valid post logout redirect URIs".
# With NEXT_PUBLIC_BASE_PATH=/hudd-dashboard: http://localhost:8765/hudd-dashboard/login
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="http://localhost:3000/login"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Webhook secret for GitHub webhook listener (generate with: openssl rand -hex 32)
WEBHOOK_SECRET="replace-with-webhook-secret"

# AI / LLM — skipped when unset
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=qwen3-30b-a3b-instruct
# LLM_PROVIDER=airawat

# Public landing "Try the demo" CTA. Unset → this deployment's own /login.
# AIRAWAT_DEMO_URL=http://demo.airawat.test:3000/

# Seed-time only
# BOOTSTRAP_TASU_EMAIL=tasu.admin@hudd.bootstrap
# SEED_FA_EMAIL=finance.desk@hudd.bootstrap
