DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/hudd"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/hudd"

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:8765/hudd-dashboard/api/auth"
AUTH_TRUST_HOST="true"

# Webhook secret for GitHub webhook listener (generate with: openssl rand -hex 32)
WEBHOOK_SECRET="replace-with-webhook-secret"

KEYCLOAK_ISSUER="http://localhost:8080/realms/<realm-name>"
KEYCLOAK_CLIENT_ID="hudd-dashboard"
# Optional override for admin role-mapping target client.
# If omitted, KEYCLOAK_CLIENT_ID is used.
KEYCLOAK_ROLE_CLIENT_ID="hudd"
KEYCLOAK_CLIENT_SECRET="replace-with-keycloak-client-secret"
KEYCLOAK_ADMIN_CLIENT_ID="hudd-dashboard-admin"
KEYCLOAK_ADMIN_CLIENT_SECRET="replace-with-keycloak-admin-client-secret"
KEYCLOAK_REALM="<realm-name>"
# Register this exact URI in Keycloak client "Valid post logout redirect URIs"
# and in "Valid Redirect URIs" if your Keycloak version requires it.
# Example: http://localhost:8765/login
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="http://localhost:8765/login"
