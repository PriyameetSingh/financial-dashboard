enum TenantStatus {
  active
  suspended
}

/// Phase 2: tenant organizations. Odisha is tenant #1 (backfilled by migration).
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(active)

  /// The commercial tier this organization bought — the CEILING on what its own
  /// administrators may switch on.
  ///
  /// Phase 4 / S3. Before this column the ceiling existed only on the onboarding
  /// token, which is spent the moment the workspace is created: a tenant admin
  /// opening the menu card afterwards had nothing to be measured against, so
  /// "cannot self-upgrade past the purchased tier" was unenforceable by
  /// construction. `TenantEntitlement.tier` is NOT the ceiling and never was —
  /// it records which tier each MODULE belongs to, so every tenant carries rows
  /// at every tier.
  ///
  /// Nullable so the migration is additive; the same migration backfills every
  /// existing row, and `planCeiling()` reads null as `core`, which is the
  /// fail-closed direction. Set from the onboarding token at provisioning.
  planTier ModuleTier?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  configEntries                  TenantConfigEntry[]
  users                          User[]
  roles                          Role[]
  verticals                      Vertical[]
  sections                       Section[]
  organisations                  Organisation[]
  designations                   Designation[]
  ulbs                           Ulb[]
  financialYears                 FinancialYear[]
  schemes                        Scheme[]
  dashboardMeetings              DashboardMeeting[]
  actionItems                    ActionItem[]
  files                          File[]
  auditLogs                      AuditLog[]
  agentConfigs                   AgentConfig[]
  agentInsights                  AgentInsight[]
  systemNotificationConfigs      SystemNotificationConfig[]
  rolePermissions                RolePermission[]
  userRoles                      UserRole[]
  userPermissionOverrides        UserPermissionOverride[]
  userSections                   UserSection[]
  userOrganisations              UserOrganisation[]
  subschemes                     Subscheme[]
  schemeAssignments              SchemeAssignment[]
  schemeWorkflowConfigs          SchemeWorkflowConfig[]
  financeBudgets                 FinanceBudget[]
  financeBudgetRevisions         FinanceBudgetRevision[]
  financeExpenditureSnapshots    FinanceExpenditureSnapshot[]
  financeSummaryHeads            FinanceSummaryHead[]
  financeBudgetSupplements       FinanceBudgetSupplement[]
  financeYearBudgetAllocations   FinanceYearBudgetAllocation[]
  financeYearBudgetCategoryLines FinanceYearBudgetCategoryLine[]
  kpiDefinitions                 KpiDefinition[]
  kpiDefinitionPerformers        KpiDefinitionPerformer[]
  kpiDefinitionReviewerUsers     KpiDefinitionReviewerUser[]
  kpiTargets                     KpiTarget[]
  kpiMeasurements                KpiMeasurement[]
  meetingTopics                  MeetingTopic[]
  meetingMaterials               MeetingMaterial[]
  actionItemPerformers           ActionItemPerformer[]
  actionItemReviewerUsers        ActionItemReviewerUser[]
  actionItemUpdates              ActionItemUpdate[]
  actionItemProofs               ActionItemProof[]
  notifications                  Notification[]
  notificationDispatches         NotificationDispatch[]
  userNotificationPreferences    UserNotificationPreference[]
  userSeenReleases               UserSeenRelease[]
  entitlements                   TenantEntitlement[]

  @@map("tenants")
}

/// Phase 2: per-tenant config KV. Typed registry in lib/tenant-config validates
/// keys/shapes and overlays rows onto ODISHA_DEFAULTS. Secret-class keys are
/// rejected by the write path (env-only) and never stored here.
model TenantConfigEntry {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_config_entries")
}

/// Phase 3: enforcement class of a module. `core` is never gated (auth, shell,
/// profile, RBAC, administration, the landing dashboard); `gated` is checked
/// against TenantEntitlement on every request; `roadmap` is catalog vocabulary —
/// no route may map to it and the guard denies if one does.
enum ModuleEnforcement {
  core
  gated
  roadmap
}

/// Phase 3: commercial tier, mirroring the Notion `Tier` property. A placeholder
/// for the future menu-card pricing — the guard NEVER reads it. A module is
/// enabled or it is not.
enum ModuleTier {
  core
  standard
  premium
  addon
}

/// Phase 3: catalog lifecycle, mirroring the Notion `Status` property.
enum ModuleStatus {
  active
  deprecated
  planned
}

/// Phase 3: the global module catalog. Tenant-INDEPENDENT, exactly like
/// `Permission`: a closed registry whose codes are referenced literally in source
/// (lib/entitlements/catalog.ts) and written only by migration/seed. It is
/// provisioning vocabulary, never tenant data, so it is listed in GLOBAL_MODELS
/// and is not auto-scoped by the chokepoint.
model Module {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  name        String
  enforcement ModuleEnforcement @default(gated)
  tier        ModuleTier?
  status      ModuleStatus      @default(active)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  entitlements TenantEntitlement[]

  @@map("modules")
}

/// Phase 3: which modules a tenant is provisioned for — what a tenant "has".
/// Tenant-scoped (carries `tenantId`), so the Phase 2 chokepoint auto-scopes
/// every application query against it with no registry change.
///
/// Absence of a row means NOT entitled (fail closed). The Phase 3 migration
/// backfills an explicit row per existing tenant per provisionable module so no
/// tenant loses a module on deploy; onboarding writes rows for new tenants.
/// Phase 4 / S2 — the authorization gate on tenant creation.
///
/// Onboarding is a privileged write reachable from a public page: it creates a
/// Tenant, its entitlements, its configuration and its permanent address. Open
/// self-serve is not survivable for this product — the sharpest risk is not
/// resource abuse but impersonation, since anyone could mint a plausible
/// `<something-official>` workspace and phish the real body it names.
///
/// So provisioning requires a token Airawat issues out of band, at contract
/// signature. Government procurement already has that step; the token rides on
/// it rather than adding friction.
///
/// Three properties make it a real control rather than a speed bump:
///
///   - only the SHA-256 hash is stored, so a database read does not yield a
///     usable token and neither does a log line;
///   - `consumedAt` is set in the same transaction that creates the tenant, so
///     two concurrent launches cannot both succeed;
///   - `tier` lives here rather than in the request, so a customer cannot
///     self-elevate by editing the payload. The wizard's module choices are
///     intersected with this tier on the server.
///
/// Issuing tokens is the control plane's job (S4, out of scope here). Until it
/// exists they are minted by `scripts/mint-onboarding-token.mjs`.
model OnboardingToken {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 of the token, hex. The token itself is shown once, at issue, and
  /// never stored.
  tokenHash String @unique

  /// Commercial tier this token authorizes. The ceiling on what it can enable.
  tier ModuleTier

  /// Who it was issued to. Operational bookkeeping; never shown to the visitor.
  label String?

  expiresAt  DateTime
  consumedAt DateTime?

  /// The tenant this token created, once it has. No relation: the token
  /// outlives nothing and deleting a tenant must not delete the audit of how it
  /// came to exist.
  tenantId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("onboarding_tokens")
}

model TenantEntitlement {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  moduleId  String      @db.Uuid
  enabled   Boolean     @default(false)
  tier      ModuleTier?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("tenant_entitlements")
}
