generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Phase 2/3 multi-tenancy ─────────────────────────────────────────────────
//
// Every tenant-owned model carries:
//
//   tenantId String @db.Uuid          -- required, NOT NULL, no column default
//
// THE TENANT IS STAMPED IN EXACTLY ONE PLACE: the Prisma client extension in
// lib/prisma.ts. Application code never writes `tenantId` by hand; it marks a
// create payload with `tenantStamped()` (lib/prisma.ts), which asserts to the
// type system what the extension guarantees at runtime. Code that legitimately
// runs outside a tenant scope — seeds, migrations, maintenance scripts — uses
// `prismaUnscoped` and passes a real `tenantId`, which the compiler now
// requires of it.
//
// HISTORY, so this is not "helpfully" reintroduced (backlog H1, resolved):
// these columns used to declare
//
//   @default(dbgenerated("(current_setting('app.tenant_id', true))::uuid"))
//
// NO DATABASE EVER HAD THAT DEFAULT. It existed only in this file, where its
// sole effect was type-level — making `tenantId` optional in generated create
// inputs. Its cost was a live hazard: the moment anything binds the
// `app.tenant_id` GUC (a Postgres Row-Level Security rollout is the obvious
// candidate, since RLS conventionally sets exactly this kind of session
// variable), the default would stop evaluating to NULL and become a SILENT
// STAMP — a write that bypassed the chokepoint would quietly land in whichever
// tenant the pooled connection last had set, instead of failing on NOT NULL.
//
// Removing it also ended a standing annoyance: `prisma migrate dev` proposed 46
// `ALTER COLUMN … SET DEFAULT` statements on every new migration, because the
// schema and every database disagreed. Schema and database now match, and the
// removal required no migration at all.
//
// If RLS is introduced later, bind the GUC per transaction and treat it as the
// authoritative tenant source, or leave the chokepoint as the only writer. Do
// not restore a column default: the two mechanisms must never be half-live.

/// Scheme sponsorship; maps to FinanceYearBudgetCategory for scheme buckets:
/// STATE → STATE_SCHEME, CENTRAL → CENTRALLY_SPONSORED_SCHEME, CENTRAL_SECTOR → CENTRAL_SECTOR_SCHEME
/// NON_FINANCIAL → no financial bucket (KPI-only schemes)
enum SponsorshipType {
  /// State sector scheme → FY line STATE_SCHEME
  STATE
  /// Centrally Sponsored Scheme → FY line CENTRALLY_SPONSORED_SCHEME
  CENTRAL
  /// Central Sector Scheme → FY line CENTRAL_SECTOR_SCHEME
  CENTRAL_SECTOR
  /// Non-financial scheme (KPI-only, no financial data)
  NON_FINANCIAL
}

enum WorkflowType {
  financial
  kpi
  action_item
}

enum SchemeAssignmentKind {
  dashboard_owner
  kpi_owner_1
  kpi_owner_2
  action_item_owner_1
  action_item_owner_2
}

enum PermissionEffect {
  allow
  deny
}

enum KPICategory {
  STATE
  CENTRAL
}

enum KPIType {
  OUTPUT
  OUTCOME
  BINARY
}

enum FinancialWorkflowStatus {
  draft
  submitted
}

enum KPIWorkflowStatus {
  draft
  submitted
  reviewed
  rejected
}

enum KPIProgressStatus {
  on_track
  delayed
  overdue
}

enum KpiEscalationFlag {
  on_track
  needs_coordination
  needs_acs_decision
}

enum KpiMonitoringLevel {
  CS
  ACS
  CM
}

enum KpiCompletionStatus {
  pending_review
  completed
  rejected
}

enum ActionItemType {
  action_item
  meeting_decision
}

enum ActionItemPriority {
  Critical
  High
  Medium
  Low
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  PROOF_UPLOADED
  UNDER_REVIEW
  COMPLETED
  OVERDUE
}

/// Buckets for per–financial-year budget allocation (budget + SO + IFMS per line)
enum FinanceYearBudgetCategory {
  STATE_SCHEME
  CENTRALLY_SPONSORED_SCHEME
  CENTRAL_SECTOR_SCHEME
  STATE_FINANCE_COMMISSION
  UNION_FINANCE_COMMISSION
  OTHER_TRANSFER_STAMP_DUTY
  ADMIN_EXPENDITURE
}

/// Government desk vs Programme Management Unit (HUDD).
enum OfficerType {
  GOVERNMENT
  PMU
}

model User {
  id                           String       @id @default(uuid()) @db.Uuid
  code                         String?
  name                         String
  email                        String
  department                   String?
  // legacy string fields removed: designation, organisation, section
  // Use normalized relations instead (designationId, organisationId, userSections)
  officerType                  OfficerType?
  isActive                     Boolean      @default(true)
  sessionsInvalidatedAt        DateTime?
  passwordChangeFailedAttempts Int          @default(0)
  passwordChangeLockedUntil    DateTime?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  // Normalized relations: keep the existing string fields for compatibility,
  // and provide optional FK links to the new reference tables.
  designationId   String?       @db.Uuid
  organisationId  String?       @db.Uuid
  ulbId           String?       @db.Uuid
  // Users may belong to multiple sections via the join table `UserSection`.
  // Users may belong to multiple organisations via the join table `UserOrganisation`.
  designationRel  Designation?  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  organisationRel Organisation? @relation("LegacyUserOrganisation", fields: [organisationId], references: [id], onDelete: SetNull)
  ulbRel          Ulb?          @relation(fields: [ulbId], references: [id], onDelete: SetNull)

  userSections      UserSection[]
  userOrganisations UserOrganisation[]

  userRoles                  UserRole[]
  createdPermissionOverrides UserPermissionOverride[] @relation("CreatedOverrides")
  permissionOverrides        UserPermissionOverride[]

  createdSchemes                      Scheme[]                      @relation("SchemeCreatedBy")
  createdSubschemes                   Subscheme[]                   @relation("SubschemeCreatedBy")
  createdFinanceBudgets               FinanceBudget[]               @relation("FinanceBudgetCreatedBy")
  createdFinanceBudgetRevisions       FinanceBudgetRevision[]       @relation("FinanceBudgetRevisionCreatedBy")
  createdExpenditureSnapshots         FinanceExpenditureSnapshot[]  @relation("FinanceSnapshotCreatedBy")
  createdFinanceSummaryHeads          FinanceSummaryHead[]          @relation("FinanceSummaryCreatedBy")
  createdKpiDefinitions               KpiDefinition[]               @relation("KpiDefinitionCreatedBy")
  kpiDefinitionPerformers             KpiDefinitionPerformer[]
  kpiDefinitionReviewerUsers          KpiDefinitionReviewerUser[]
  requestedKpiCompletions             KpiDefinition[]               @relation("KpiDefinitionCompletionRequestedBy")
  reviewedKpiCompletions              KpiDefinition[]               @relation("KpiDefinitionCompletionReviewedBy")
  createdKpiMeasurements              KpiMeasurement[]              @relation("KpiMeasurementCreatedBy")
  reviewedKpiMeasurements             KpiMeasurement[]              @relation("KpiMeasurementReviewedBy")
  createdMeetings                     DashboardMeeting[]            @relation("MeetingCreatedBy")
  createdMeetingTopics                MeetingTopic[]                @relation("MeetingTopicCreatedBy")
  uploadedMeetingMaterials            MeetingMaterial[]             @relation("MeetingMaterialUploadedBy")
  createdActionItems                  ActionItem[]                  @relation("ActionItemCreatedBy")
  actionItemPerformers                ActionItemPerformer[]
  actionItemReviewerUsers             ActionItemReviewerUser[]
  createdActionItemUpdates            ActionItemUpdate[]            @relation("ActionItemUpdateCreatedBy")
  uploadedFiles                       File[]                        @relation("FileUploadedBy")
  actionItemProofs                    ActionItemProof[]             @relation("ActionItemProofUploadedBy")
  createdBudgetSupplements            FinanceBudgetSupplement[]     @relation("FinanceBudgetSupplementCreatedBy")
  createdFinanceYearBudgetAllocations FinanceYearBudgetAllocation[] @relation("FinanceYearBudgetAllocationCreatedBy")

  auditLogs AuditLog[]

  schemeAssignments SchemeAssignment[]
  seenReleases      UserSeenRelease[]

  notifications     Notification[]
  notificationPrefs UserNotificationPreference[]
  updatedConfigs    SystemNotificationConfig[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions   RolePermission[]
  userRoles         UserRole[]
  schemeAssignments SchemeAssignment[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("CreatedOverrides", fields: [createdById], references: [id], onDelete: SetNull)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId])
  @@index([tenantId])
  @@map("user_permission_overrides")
}

model Vertical {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionItems ActionItem[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("verticals")
}

/// Organizational sections (e.g. Accounts, PHE, Municipal- II ...)
model Section {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userSections UserSection[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sections")
}

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]             @relation("LegacyUserOrganisation")
  userOrganisations UserOrganisation[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("organisations")
}

model Designation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("designations")
}

model Ulb {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("ulbs")
}

model UserSection {
  userId    String @db.Uuid
  sectionId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, sectionId])
  @@index([tenantId])
  @@map("user_sections")
}

model UserOrganisation {
  userId         String @db.Uuid
  organisationId String @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, organisationId])
  @@index([tenantId])
  @@map("user_organisations")
}

model FinancialYear {
  id        String   @id @default(uuid()) @db.Uuid
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financeBudgets              FinanceBudget[]
  financeExpenditureSnapshots FinanceExpenditureSnapshot[]
  financeSummaryHeads         FinanceSummaryHead[]
  kpiTargets                  KpiTarget[]
  supplements                 FinanceBudgetSupplement[]
  financeYearBudgetAllocation FinanceYearBudgetAllocation?
  meetings                    DashboardMeeting[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("financial_years")
}

model Scheme {
  id              String          @id @default(uuid()) @db.Uuid
  code            String
  name            String
  verticalName    String
  sponsorshipType SponsorshipType
  archived        Boolean         @default(false)
  sortOrder       Int             @default(0)
  createdById     String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy User? @relation("SchemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  subschemes           Subscheme[]
  assignments          SchemeAssignment[]
  workflowConfigs      SchemeWorkflowConfig[]
  financeBudgets       FinanceBudget[]
  expenditureSnapshots FinanceExpenditureSnapshot[]
  kpiDefinitions       KpiDefinition[]
  actionItems          ActionItem[]
  supplements          FinanceBudgetSupplement[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("schemes")
}

model Subscheme {
  id          String   @id @default(uuid()) @db.Uuid
  schemeId    String   @db.Uuid
  code        String
  name        String
  sortOrder   Int      @default(0)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheme    Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("SubschemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments          SchemeAssignment[]
  financeBudgets       FinanceBudget[]
  expenditureSnapshots FinanceExpenditureSnapshot[]
  kpiDefinitions       KpiDefinition[]
  actionItems          ActionItem[]
  supplements          FinanceBudgetSupplement[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([schemeId, code])
  @@index([tenantId])
  @@map("subschemes")
}

model SchemeAssignment {
  id             String               @id @default(uuid()) @db.Uuid
  schemeId       String               @db.Uuid
  subschemeId    String?              @db.Uuid
  assignmentKind SchemeAssignmentKind
  userId         String?              @db.Uuid
  roleId         String?              @db.Uuid
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())

  scheme    Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme Subscheme? @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([schemeId, assignmentKind])
  @@index([tenantId])
  @@map("scheme_assignments")
}

model SchemeWorkflowConfig {
  id           String       @id @default(uuid()) @db.Uuid
  schemeId     String       @db.Uuid
  workflowType WorkflowType
  config       Json
  updatedAt    DateTime     @updatedAt

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([schemeId, workflowType])
  @@index([tenantId])
  @@map("scheme_workflow_configs")
}

model FinanceBudget {
  id               String   @id @default(uuid()) @db.Uuid
  schemeId         String   @db.Uuid
  subschemeId      String?  @db.Uuid
  financialYearId  String   @db.Uuid
  budgetEstimateCr Decimal  @db.Decimal(16, 2)
  locked           Boolean  @default(false)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scheme        Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme     Subscheme?    @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceBudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  revisions FinanceBudgetRevision[]

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([schemeId, subschemeId, financialYearId])
  @@index([financialYearId])
  @@index([tenantId])
  @@map("finance_budgets")
}

model FinanceBudgetRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  financeBudgetId     String   @db.Uuid
  oldBudgetEstimateCr Decimal  @db.Decimal(16, 2)
  newBudgetEstimateCr Decimal  @db.Decimal(16, 2)
  reason              String
  createdById         String?  @db.Uuid
  createdAt           DateTime @default(now())

  financeBudget FinanceBudget @relation(fields: [financeBudgetId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceBudgetRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([financeBudgetId])
  @@index([tenantId])
  @@map("finance_budget_revisions")
}

model FinanceExpenditureSnapshot {
  id                String                  @id @default(uuid()) @db.Uuid
  schemeId          String                  @db.Uuid
  subschemeId       String?                 @db.Uuid
  financialYearId   String                  @db.Uuid
  meetingId         String?                 @db.Uuid
  asOfDate          DateTime                @db.Date
  soExpenditureCr   Decimal                 @db.Decimal(16, 2)
  ifmsExpenditureCr Decimal                 @db.Decimal(16, 2)
  remarks           String?
  workflowStatus    FinancialWorkflowStatus @default(draft)
  createdById       String?                 @db.Uuid
  createdAt         DateTime                @default(now())

  scheme        Scheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme     Subscheme?        @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  financialYear FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  meeting       DashboardMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("FinanceSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([schemeId, financialYearId, asOfDate])
  @@index([financialYearId, asOfDate])
  @@index([meetingId])
  @@index([tenantId])
  @@map("finance_expenditure_snapshots")
}

/// Dated snapshot rows; scheme buckets (STATE_SCHEME / CENTRALLY_SPONSORED / CENTRAL_SECTOR) are derived from scheme data — use POST /summary only for manual heads (commissions, transfer, admin). Current FY totals also live on `FinanceYearBudgetCategoryLine`.
model FinanceSummaryHead {
  id                String   @id @default(uuid()) @db.Uuid
  financialYearId   String   @db.Uuid
  headCode          String
  asOfDate          DateTime @db.Date
  budgetEstimateCr  Decimal  @db.Decimal(16, 2)
  soExpenditureCr   Decimal  @db.Decimal(16, 2)
  ifmsExpenditureCr Decimal  @db.Decimal(16, 2)
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceSummaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Phase 2 multi-tenancy: nullable at Gate B (backfilled to Odisha), NOT NULL at Gate D.
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([financialYearId, headCode, asOfDate])
  @@index([financialYearId, asOfDate])
  @@index([tenantId])
  @@map("finance_summary_heads")
}

model KpiDefinition {
  id              String              @id @default(uuid()) @db.Uuid
  schemeId        String              @db.Uuid
  subschemeId     String?             @db.Uuid
  category        KPICategory
  description     String
  kpiType         KPIType
  numeratorUnit   String?
  denominatorUnit String?
  monitoringLevel KpiMonitoringLevel?
  createdById     String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  archived        Boolean             @default(false)

  /// User-initiated completion workflow (distinct from admin archiving).
  completionStatus        KpiCompletionStatus?
  completionNote          String?
  completionRequestedAt   DateTime?
  completionRequestedById String?              @db.Uuid
  completionReviewedAt    DateTime?
  completionReviewedById  String?              @db.Uuid
  completionReviewNote    String?

  scheme                Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme             Subscheme? @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  createdBy             User?      @relation("KpiDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
