generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Scheme sponsorship; maps to FinanceYearBudgetCategory for scheme buckets:
/// STATE → STATE_SCHEME, CENTRAL → CENTRALLY_SPONSORED_SCHEME, CENTRAL_SECTOR → CENTRAL_SECTOR_SCHEME
/// NON_FINANCIAL → no financial bucket (KPI-only schemes)
enum SponsorshipType {
  /// State sector scheme → FY line STATE_SCHEME
  STATE
  /// Centrally Sponsored Scheme → FY line CENTRALLY_SPONSORED_SCHEME
  CENTRAL
  /// Central Sector Scheme → FY line CENTRAL_SECTOR_SCHEME
  CENTRAL_SECTOR
  /// Non-financial scheme (KPI-only, no financial data)
  NON_FINANCIAL
}

enum WorkflowType {
  financial
  kpi
  action_item
}

enum SchemeAssignmentKind {
  dashboard_owner
  kpi_owner_1
  kpi_owner_2
  action_item_owner_1
  action_item_owner_2
}

enum PermissionEffect {
  allow
  deny
}

enum KPICategory {
  STATE
  CENTRAL
}

enum KPIType {
  OUTPUT
  OUTCOME
  BINARY
}

enum FinancialWorkflowStatus {
  draft
  submitted
}

enum KPIWorkflowStatus {
  draft
  submitted
  reviewed
  rejected
}

enum KPIProgressStatus {
  on_track
  delayed
  overdue
}

enum KpiEscalationFlag {
  on_track
  needs_coordination
  needs_acs_decision
}

enum KpiMonitoringLevel {
  CS
  ACS
  CM
}

enum ActionItemType {
  action_item
  meeting_decision
}

enum ActionItemPriority {
  Critical
  High
  Medium
  Low
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  PROOF_UPLOADED
  UNDER_REVIEW
  COMPLETED
  OVERDUE
}

/// Buckets for per–financial-year budget allocation (budget + SO + IFMS per line)
enum FinanceYearBudgetCategory {
  STATE_SCHEME
  CENTRALLY_SPONSORED_SCHEME
  CENTRAL_SECTOR_SCHEME
  STATE_FINANCE_COMMISSION
  UNION_FINANCE_COMMISSION
  OTHER_TRANSFER_STAMP_DUTY
  ADMIN_EXPENDITURE
}

/// Government desk vs Programme Management Unit (HUDD).
enum OfficerType {
  GOVERNMENT
  PMU
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  code         String?  @unique
  name         String
  email        String   @unique
  department   String?
  // legacy string fields removed: designation, organisation, section
  // Use normalized relations instead (designationId, organisationId, userSections)
  officerType  OfficerType?
  isActive     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Normalized relations: keep the existing string fields for compatibility,
  // and provide optional FK links to the new reference tables.
  designationId  String? @db.Uuid
  organisationId String? @db.Uuid
  ulbId          String? @db.Uuid
  // Users may belong to multiple sections via the join table `UserSection`.
  // Users may belong to multiple organisations via the join table `UserOrganisation`.
  designationRel  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  organisationRel Organisation? @relation("LegacyUserOrganisation", fields: [organisationId], references: [id], onDelete: SetNull)
  ulbRel          Ulb?          @relation(fields: [ulbId], references: [id], onDelete: SetNull)

  userSections UserSection[]
  userOrganisations UserOrganisation[]

  userRoles            UserRole[]
  createdPermissionOverrides UserPermissionOverride[] @relation("CreatedOverrides")
  permissionOverrides  UserPermissionOverride[]

  createdSchemes        Scheme[]               @relation("SchemeCreatedBy")
  createdSubschemes     Subscheme[]            @relation("SubschemeCreatedBy")
  createdFinanceBudgets FinanceBudget[]        @relation("FinanceBudgetCreatedBy")
  createdFinanceBudgetRevisions FinanceBudgetRevision[] @relation("FinanceBudgetRevisionCreatedBy")
  createdExpenditureSnapshots FinanceExpenditureSnapshot[] @relation("FinanceSnapshotCreatedBy")
  createdFinanceSummaryHeads FinanceSummaryHead[] @relation("FinanceSummaryCreatedBy")
  createdKpiDefinitions KpiDefinition[]        @relation("KpiDefinitionCreatedBy")
  kpiDefinitionPerformers KpiDefinitionPerformer[]
  kpiDefinitionReviewerUsers KpiDefinitionReviewerUser[]
  createdKpiMeasurements KpiMeasurement[]      @relation("KpiMeasurementCreatedBy")
  reviewedKpiMeasurements KpiMeasurement[]     @relation("KpiMeasurementReviewedBy")
  createdMeetings       DashboardMeeting[]     @relation("MeetingCreatedBy")
  createdMeetingTopics  MeetingTopic[]         @relation("MeetingTopicCreatedBy")
  uploadedMeetingMaterials MeetingMaterial[]   @relation("MeetingMaterialUploadedBy")
  createdActionItems    ActionItem[]           @relation("ActionItemCreatedBy")
  actionItemPerformers  ActionItemPerformer[]
  actionItemReviewerUsers ActionItemReviewerUser[]
  createdActionItemUpdates ActionItemUpdate[]  @relation("ActionItemUpdateCreatedBy")
  uploadedFiles         File[]                 @relation("FileUploadedBy")
  actionItemProofs      ActionItemProof[]      @relation("ActionItemProofUploadedBy")
  createdBudgetSupplements FinanceBudgetSupplement[] @relation("FinanceBudgetSupplementCreatedBy")
  createdFinanceYearBudgetAllocations FinanceYearBudgetAllocation[] @relation("FinanceYearBudgetAllocationCreatedBy")

  auditLogs             AuditLog[]

  schemeAssignments      SchemeAssignment[]

  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  schemeAssignments SchemeAssignment[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("CreatedOverrides", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model Vertical {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionItems ActionItem[]

  @@map("verticals")
}

/// Organizational sections (e.g. Accounts, PHE, Municipal- II ...)
model Section {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userSections UserSection[]

  @@map("sections")
}

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[] @relation("LegacyUserOrganisation")
  userOrganisations UserOrganisation[]

  @@map("organisations")
}

model Designation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@map("designations")
}

model Ulb {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@map("ulbs")
}

model UserSection {
  userId    String @db.Uuid
  sectionId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@map("user_sections")
}

model UserOrganisation {
  userId         String @db.Uuid
  organisationId String @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId])
  @@map("user_organisations")
}

model FinancialYear {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financeBudgets            FinanceBudget[]
  financeExpenditureSnapshots FinanceExpenditureSnapshot[]
  financeSummaryHeads       FinanceSummaryHead[]
  kpiTargets                KpiTarget[]
  supplements FinanceBudgetSupplement[]
  financeYearBudgetAllocation FinanceYearBudgetAllocation?
  meetings                  DashboardMeeting[]

  @@map("financial_years")
}

model Scheme {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  name            String
  verticalName    String
  sponsorshipType SponsorshipType
  archived        Boolean         @default(false)
  createdById     String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy  User?    @relation("SchemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  subschemes          Subscheme[]
  assignments         SchemeAssignment[]
  workflowConfigs     SchemeWorkflowConfig[]
  financeBudgets      FinanceBudget[]
  expenditureSnapshots FinanceExpenditureSnapshot[]
  kpiDefinitions      KpiDefinition[]
  actionItems         ActionItem[]
  supplements FinanceBudgetSupplement[]

  @@map("schemes")
}

model Subscheme {
  id          String   @id @default(uuid()) @db.Uuid
  schemeId    String   @db.Uuid
  code        String
  name        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheme    Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("SubschemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments          SchemeAssignment[]
  financeBudgets       FinanceBudget[]
  expenditureSnapshots FinanceExpenditureSnapshot[]
  kpiDefinitions       KpiDefinition[]
  actionItems          ActionItem[]
  supplements FinanceBudgetSupplement[]



  @@unique([schemeId, code])
  @@map("subschemes")
}

model SchemeAssignment {
  id             String               @id @default(uuid()) @db.Uuid
  schemeId       String               @db.Uuid
  subschemeId    String?              @db.Uuid
  assignmentKind SchemeAssignmentKind
  userId         String?              @db.Uuid
  roleId         String?              @db.Uuid
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())

  scheme    Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme Subscheme? @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([schemeId, assignmentKind])
  @@map("scheme_assignments")
}

model SchemeWorkflowConfig {
  id           String       @id @default(uuid()) @db.Uuid
  schemeId     String       @db.Uuid
  workflowType WorkflowType
  config       Json
  updatedAt    DateTime     @updatedAt

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, workflowType])
  @@map("scheme_workflow_configs")
}

model FinanceBudget {
  id             String   @id @default(uuid()) @db.Uuid
  schemeId       String   @db.Uuid
  subschemeId    String?  @db.Uuid
  financialYearId String  @db.Uuid
  budgetEstimateCr Decimal @db.Decimal(16, 2)
  locked         Boolean  @default(false)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scheme       Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme    Subscheme?    @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("FinanceBudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  revisions FinanceBudgetRevision[]

  @@unique([schemeId, subschemeId, financialYearId])
  @@index([financialYearId])
  @@map("finance_budgets")
}

model FinanceBudgetRevision {
  id             String   @id @default(uuid()) @db.Uuid
  financeBudgetId String  @db.Uuid
  oldBudgetEstimateCr Decimal @db.Decimal(16, 2)
  newBudgetEstimateCr Decimal @db.Decimal(16, 2)
  reason         String
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  financeBudget FinanceBudget @relation(fields: [financeBudgetId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceBudgetRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([financeBudgetId])
  @@map("finance_budget_revisions")
}

model FinanceExpenditureSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  schemeId         String   @db.Uuid
  subschemeId      String?  @db.Uuid
  financialYearId  String   @db.Uuid
  meetingId        String?  @db.Uuid
  asOfDate         DateTime @db.Date
  soExpenditureCr  Decimal  @db.Decimal(16, 2)
  ifmsExpenditureCr Decimal @db.Decimal(16, 2)
  remarks          String?
  workflowStatus   FinancialWorkflowStatus @default(draft)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())

  scheme        Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme     Subscheme?    @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  meeting       DashboardMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("FinanceSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schemeId, financialYearId, asOfDate])
  @@index([financialYearId, asOfDate])
  @@index([meetingId])
  @@map("finance_expenditure_snapshots")
}

/// Dated snapshot rows; scheme buckets (STATE_SCHEME / CENTRALLY_SPONSORED / CENTRAL_SECTOR) are derived from scheme data — use POST /summary only for manual heads (commissions, transfer, admin). Current FY totals also live on `FinanceYearBudgetCategoryLine`.
model FinanceSummaryHead {
  id              String   @id @default(uuid()) @db.Uuid
  financialYearId  String   @db.Uuid
  headCode         String
  asOfDate         DateTime @db.Date
  budgetEstimateCr Decimal  @db.Decimal(16, 2)
  soExpenditureCr  Decimal  @db.Decimal(16, 2)
  ifmsExpenditureCr Decimal @db.Decimal(16, 2)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceSummaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([financialYearId, headCode, asOfDate])
  @@index([financialYearId, asOfDate])
  @@map("finance_summary_heads")
}

model KpiDefinition {
  id              String              @id @default(uuid()) @db.Uuid
  schemeId        String              @db.Uuid
  subschemeId     String?             @db.Uuid
  category        KPICategory
  description     String
  kpiType         KPIType
  numeratorUnit   String?
  denominatorUnit String?
  monitoringLevel KpiMonitoringLevel?
  createdById     String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  archived        Boolean             @default(false)

  scheme     Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme  Subscheme? @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("KpiDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  performers KpiDefinitionPerformer[]
  reviewerUsers KpiDefinitionReviewerUser[]

  targets KpiTarget[]

  @@index([schemeId])
  @@map("kpi_definitions")
}

/// Users who may enter / update KPI measurements for this definition (when non-empty, overrides scheme-level kpi_owner_1).
model KpiDefinitionPerformer {
  kpiDefinitionId String @db.Uuid
  userId          String @db.Uuid
  sortOrder       Int    @default(0)

  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kpiDefinitionId, userId])
  @@map("kpi_definition_performers")
}

/// Users who may review KPI submissions for this definition (when non-empty, overrides scheme-level kpi_owner_2).
model KpiDefinitionReviewerUser {
  kpiDefinitionId String @db.Uuid
  userId          String @db.Uuid
  sortOrder       Int    @default(0)

  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kpiDefinitionId, userId])
  @@map("kpi_definition_reviewers")
}

model KpiTarget {
  id             String   @id @default(uuid()) @db.Uuid
  kpiDefinitionId String  @db.Uuid
  financialYearId String  @db.Uuid
  denominatorValue Decimal? @db.Decimal(16, 2)
  createdAt      DateTime @default(now())

  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  measurements KpiMeasurement[]

  @@unique([kpiDefinitionId, financialYearId])
  @@map("kpi_targets")
}

model KpiMeasurement {
  id             String            @id @default(uuid()) @db.Uuid
  kpiTargetId    String            @db.Uuid
  meetingId      String?           @db.Uuid
  measuredAt     DateTime
  numeratorValue Decimal?          @db.Decimal(16, 2)
  yesValue       Boolean?
  progressStatus   KPIProgressStatus
  workflowStatus   KPIWorkflowStatus
  remarks          String?
  bottleneckReason String?
  escalationFlag   KpiEscalationFlag?
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())
  reviewedById   String?           @db.Uuid
  reviewedAt     DateTime?
  reviewNote     String?

  kpiTarget  KpiTarget @relation(fields: [kpiTargetId], references: [id], onDelete: Cascade)
  meeting    DashboardMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("KpiMeasurementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("KpiMeasurementReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([kpiTargetId, measuredAt])
  @@index([meetingId])
  @@map("kpi_measurements")
}

model DashboardMeeting {
  id              String   @id @default(uuid()) @db.Uuid
  meetingDate     DateTime @db.Date
  title           String?
  notes           String?
  financialYearId String?  @db.Uuid
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())

  createdBy    User?         @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  financialYear FinancialYear? @relation(fields: [financialYearId], references: [id], onDelete: SetNull)

  topics     MeetingTopic[]
  actionItems ActionItem[]
  materials  MeetingMaterial[]
  kpiMeasurements            KpiMeasurement[]
  financeExpenditureSnapshots FinanceExpenditureSnapshot[]
  actionItemProgressUpdates  ActionItemUpdate[]

  @@index([meetingDate])
  @@map("dashboard_meetings")
}

model MeetingTopic {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @db.Uuid
  topic       String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  meeting   DashboardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("MeetingTopicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_topics")
}

model MeetingMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @db.Uuid
  storagePath String   @unique
  fileName    String
  mimeType    String?
  sizeBytes   Int?
  sortOrder   Int      @default(0)
  uploadedById String? @db.Uuid
  createdAt   DateTime @default(now())

  meeting    DashboardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy User?            @relation("MeetingMaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_materials")
}

model ActionItem {
  id           String           @id @default(uuid()) @db.Uuid
  meetingId    String?          @db.Uuid
  schemeId     String?          @db.Uuid
  subschemeId  String?          @db.Uuid
  verticalId   String?          @db.Uuid
  itemType     ActionItemType
  title        String
  description  String
  priority     ActionItemPriority
  dueDate      DateTime         @db.Date
  status       ActionItemStatus
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  meeting   DashboardMeeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  scheme    Scheme?           @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme Subscheme?       @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  vertical  Vertical?        @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  performers    ActionItemPerformer[]
  reviewerUsers ActionItemReviewerUser[]
  createdBy   User? @relation("ActionItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updates ActionItemUpdate[]
  proofs  ActionItemProof[]

  @@index([status, dueDate])
  @@index([meetingId])
  @@map("action_items")
}

model ActionItemPerformer {
  actionItemId String @db.Uuid
  userId       String @db.Uuid
  sortOrder    Int    @default(0)

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([actionItemId, userId])
  @@map("action_item_performers")
}

model ActionItemReviewerUser {
  actionItemId String @db.Uuid
  userId       String @db.Uuid
  sortOrder    Int    @default(0)

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([actionItemId, userId])
  @@map("action_item_reviewers")
}

model ActionItemUpdate {
  id           String         @id @default(uuid()) @db.Uuid
  actionItemId String         @db.Uuid
  meetingId    String?        @db.Uuid
  timestamp    DateTime
  status       ActionItemStatus
  note         String
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now())

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  meeting    DashboardMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("ActionItemUpdateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([actionItemId, timestamp])
  @@index([meetingId])
  @@map("action_item_updates")
}

model File {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  url         String
  mimeType    String?
  sizeBytes   Int?
  uploadedById String? @db.Uuid
  uploadedAt  DateTime @default(now())

  uploadedBy User? @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  actionItemProofs ActionItemProof[]

  @@map("files")
}

model ActionItemProof {
  id          String   @id @default(uuid()) @db.Uuid
  actionItemId String  @db.Uuid
  fileId      String   @db.Uuid
  uploadedById String? @db.Uuid
  uploadedAt  DateTime @default(now())

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation("ActionItemProofUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([actionItemId, fileId])
  @@map("action_item_proofs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now())
  actorUserId String? @db.Uuid
  actionType String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@map("audit_log")
}

model FinanceBudgetSupplement {
  id              String   @id @default(uuid()) @db.Uuid
  schemeId        String   @db.Uuid
  subschemeId     String?  @db.Uuid
  financialYearId String   @db.Uuid

  // Signed value — positive = top-up, negative = diversion/cut
  amountCr        Decimal  @db.Decimal(16, 2)

  // Why this supplement exists — mandatory
  reason          String
  // Optional reference (e.g. sanction order number)
  referenceNo     String?

  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())

  scheme        Scheme        @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subscheme     Subscheme?    @relation(fields: [subschemeId], references: [id], onDelete: Cascade)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceBudgetSupplementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schemeId, financialYearId])
  @@map("finance_budget_supplements")
}

/// Per–financial-year total and breakdown; totalBudgetCr should equal sum of category line budgetEstimateCr (enforce in app).
model FinanceYearBudgetAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  financialYearId  String   @unique @db.Uuid
  totalBudgetCr    Decimal  @db.Decimal(16, 2)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("FinanceYearBudgetAllocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  categoryLines FinanceYearBudgetCategoryLine[]

  @@map("finance_year_budget_allocations")
}

model FinanceYearBudgetCategoryLine {
  id                String   @id @default(uuid()) @db.Uuid
  allocationId      String   @db.Uuid
  category          FinanceYearBudgetCategory
  budgetEstimateCr  Decimal  @db.Decimal(16, 2)
  soExpenditureCr   Decimal  @db.Decimal(16, 2)
  ifmsExpenditureCr Decimal  @db.Decimal(16, 2)

  allocation FinanceYearBudgetAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@unique([allocationId, category])
  @@map("finance_year_budget_category_lines")
}