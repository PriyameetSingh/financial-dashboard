# Test-database env for vitest / `npm run prisma:migrate:test` / `db:seed:test`.
# Copy to `.env.test.local` (git-ignored). Docker Compose creates hudd_test
# during `init`; never run seed_demo_tenant.js against this database.

DATABASE_URL="postgresql://hudd_user:hudd_password@127.0.0.1:5433/hudd_test"
DIRECT_URL="postgresql://hudd_user:hudd_password@127.0.0.1:5433/hudd_test"

NEXT_PUBLIC_BASE_PATH=""

AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000/api/auth"
AUTH_TRUST_HOST="true"
DEV_AUTH_ENABLED="1"
DEV_DEFAULT_TENANT_SLUG=""

KEYCLOAK_ISSUER="http://13.206.129.143:8080/realms/airawat-dashboard"
KEYCLOAK_CLIENT_ID="airawat-web"
KEYCLOAK_CLIENT_SECRET="replace-with-keycloak-client-secret"
KEYCLOAK_ROLE_CLIENT_ID="airawat-web"
KEYCLOAK_ADMIN_CLIENT_ID="replace-with-keycloak-admin-client-id"
KEYCLOAK_ADMIN_CLIENT_SECRET="replace-with-keycloak-admin-client-secret"
KEYCLOAK_REALM="airawat-dashboard"
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="http://localhost:3000/login"
