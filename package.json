{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 8765",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart hudd-dashboard",
    "pm2:logs": "pm2 logs hudd-dashboard",
    "redeploy": "npm run build && (pm2 restart hudd-dashboard || pm2 start ecosystem.config.cjs)",
    "dev:test": "NODE_ENV=test next dev -p 8766",
    "start:test": "next start -H 0.0.0.0 -p 8766",
    "pm2:start:test": "pm2 start ecosystem.config.cjs --only hudd-dashboard-test",
    "pm2:restart:test": "pm2 restart hudd-dashboard-test --update-env",
    "pm2:logs:test": "pm2 logs hudd-dashboard-test",
    "redeploy:test": "npm run build && (pm2 restart hudd-dashboard-test || pm2 start ecosystem.config.cjs --only hudd-dashboard-test)",
    "prisma:migrate:test": "node --env-file=.env.test.local node_modules/.bin/prisma migrate deploy",
    "prisma:studio:test": "node --env-file=.env.test.local node_modules/.bin/prisma studio --port 5556",
    "db:seed:test": "node --env-file=.env.test.local node_modules/.bin/prisma db seed",
    "db:seed:roles:test": "node --env-file=.env.test.local prisma/seed_roles.js",
    "db:clear-mock:test": "node --env-file=.env.test.local node_modules/.bin/tsx prisma/clear_mock_data.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:roles": "node prisma/seed_roles.js",
    "db:clear-mock": "tsx prisma/clear_mock_data.ts",
    "db:clear-and-reseed-roles": "tsx prisma/clear_mock_data.ts --yes --reset-rbac && node prisma/seed_roles.js",
    "verify:behaviors": "node scripts/verify-behaviors.mjs",
    "check:api-guards": "node scripts/check-api-guards.mjs",
    "check:tenancy-lint": "node scripts/check-tenancy-lint.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "golden": "node scripts/run-golden.mjs",
    "migrate:prod": "bash scripts/migrate-prod.sh",
    "backup:prod:db": "bash scripts/backup-prod-db.sh",
    "webhook:start": "pm2 start ecosystem.config.cjs --only webhook-server",
    "webhook:restart": "pm2 restart webhook-server",
    "webhook:logs": "pm2 logs webhook-server",
    "deploy:test": "bash scripts/deploy-test.sh",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "seed:users:csv": "tsx scripts/seed-users-from-csv.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.1.1",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright-core": "^1.56.1",
    "pm2": "^6.0.14",
    "prisma": "^6.6.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
